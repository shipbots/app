{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "ios-simulator": {
      "channel": "preview",
      "ios": { "simulator": true }
    },
    "ios-testflight": {
      "channel": "preview",
      "autoIncrement": true,
      "ios": {}
    },
    "production": {
      "autoIncrement": true,
      "channel": "preview",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
